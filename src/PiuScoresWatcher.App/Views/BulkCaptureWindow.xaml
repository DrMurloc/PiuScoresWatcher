<Window x:Class="PiuScoresWatcher.App.Views.BulkCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PiuScoresWatcher.App"
        xmlns:sounds="clr-namespace:PiuScoresWatcher.App.Sounds"
        Title="{x:Static app:Copy.AppName}"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Iteration 2: the mocks' start window for a bulk capture (watcher.md D51). It explains the moves
         every time, because a run is rare and the keys are easy to forget. Every string is Copy's (D36). -->
    <Window.Resources>
        <!-- A key cap in step 2, drawn from each {KEY} token in Copy.BulkStep2. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <!-- The round button that plays one of the sounds; its edge turns accent under the pointer. -->
        <Style x:Key="PlaySound" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Round" CornerRadius="16" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                            <Path Width="10" Height="12" Margin="2,0,0,0" Stretch="Fill" Data="M0,0 L9,5 L0,10 Z"
                                  Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Round" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Round" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,12,24,20">
        <TextBlock Text="{x:Static app:Copy.BulkHeadline}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static app:Copy.BulkLede}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,2,0,12" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="1." Margin="0,0,8,6" />
                <TextBlock Grid.Column="1" Margin="0,0,0,6" Text="{x:Static app:Copy.BulkStep1}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="2." Margin="0,2,8,6" />
                <TextBlock x:Name="Step2" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap"
                           LineStackingStrategy="BlockLineHeight" LineHeight="23" />
                <TextBlock Grid.Row="2" Text="3." Margin="0,0,8,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static app:Copy.BulkStep3}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource PlaySound}" Tag="{x:Static sounds:CaptureSound.Chime}" Click="OnPreview"
                            AutomationProperties.LabeledBy="{Binding ElementName=ChimeName}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ChimeName" Text="{x:Static app:Copy.SoundChime}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static app:Copy.SoundChimeMeaning}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource PlaySound}" Tag="{x:Static sounds:CaptureSound.Tick}" Click="OnPreview"
                            AutomationProperties.LabeledBy="{Binding ElementName=TickName}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TickName" Text="{x:Static app:Copy.SoundTick}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static app:Copy.SoundTickMeaning}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <Button Style="{StaticResource PlaySound}" Tag="{x:Static sounds:CaptureSound.LowTone}" Click="OnPreview"
                            AutomationProperties.LabeledBy="{Binding ElementName=LowName}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LowName" Text="{x:Static app:Copy.SoundLow}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static app:Copy.SoundLowMeaning}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="BestsText" Style="{StaticResource Secondary}" />
        <CheckBox x:Name="SoundsBox" Margin="0,10,0,0" Content="{x:Static app:Copy.PlaySounds}"
                  Checked="OnSoundsChanged" Unchecked="OnSoundsChanged" />

        <DockPanel Margin="0,16,0,0">
            <Button x:Name="StartButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="20,4" Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static app:Copy.Start}" IsDefault="True" IsEnabled="False" Click="OnStart" />
            <Button DockPanel.Dock="Right" Padding="14,4" Content="{x:Static app:Copy.Cancel}" IsCancel="True" Click="OnCancel" />
            <TextBlock Text="{x:Static app:Copy.BulkStopsItself}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </StackPanel>
</Window>
