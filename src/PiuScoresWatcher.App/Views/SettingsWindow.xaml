<Window x:Class="PiuScoresWatcher.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PiuScoresWatcher.App"
        Title="{x:Static app:Copy.AppName}"
        Icon="/Assets/app.ico"
        Width="500" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!-- Iteration 1: the mocks' settings window (watcher.md D37), plus the notification switches of
         D35; iteration 2 adds bulk capture (D51): the status card during a run, its section, its
         summary's switch, and a run's one line in Recent; the Language section closes it (D59). Every
         string is Copy's (D36). -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,16">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="PauseButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,4" VerticalAlignment="Center" Click="OnPause" />
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionAccount}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel x:Name="ConnectedPanel">
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,4" Content="{x:Static app:Copy.Disconnect}" Click="OnDisconnect" />
                        <TextBlock x:Name="ConnectedText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel x:Name="ConnectPanel">
                        <TextBlock Text="{x:Static app:Copy.TokenLabel}" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,4"
                                    Content="{x:Static app:Copy.Connect}" Click="OnConnect" />
                            <PasswordBox x:Name="TokenBox" />
                        </DockPanel>
                        <TextBlock x:Name="ConnectionText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="TokenHelpText" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionWatching}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <RadioButton x:Name="ModeGame" GroupName="Mode" Margin="0,0,20,0" Content="{x:Static app:Copy.ModeGame}" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeSteam" GroupName="Mode" Margin="0,0,20,0" Content="{x:Static app:Copy.ModeSteamShort}" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeBoth" GroupName="Mode" Content="{x:Static app:Copy.ModeBothShort}" Checked="OnModeChanged" />
                    </WrapPanel>
                    <StackPanel x:Name="FolderPanel">
                        <Border Height="1" Margin="0,10" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,4" VerticalAlignment="Center"
                                    Content="{x:Static app:Copy.Change}" Click="OnChangeFolder" />
                            <StackPanel>
                                <TextBlock x:Name="FolderLine" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="FolderPath" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionBulk}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="StartBulkButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,4" VerticalAlignment="Center"
                                Content="{x:Static app:Copy.StartEllipsis}" Click="OnStartBulk" />
                        <TextBlock Text="{x:Static app:Copy.BulkSettingsLine}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <CheckBox x:Name="BulkSoundsBox" Style="{StaticResource Switch}" Content="{x:Static app:Copy.SoundsWhileCapturing}"
                              Checked="OnBulkSoundsChanged" Unchecked="OnBulkSoundsChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionStartup}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Switch}" Checked="OnStartupChanged" Unchecked="OnStartupChanged">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Copy.StartWithWindows}" />
                        <TextBlock Text="{x:Static app:Copy.StartWithWindowsShort}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </CheckBox>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionRecent}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <TextBlock x:Name="NoPlays" Text="{x:Static app:Copy.NoPlaysYet}" Style="{StaticResource Secondary}" Margin="16,10" />
                    <!-- The columns share their widths across the rows and grow to the widest word, from the mock's
                         widths up: "maintenant" or a Japanese date is wider than "now" or "Sep 24" (D61). -->
                    <ItemsControl x:Name="RecentList" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentScore" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentGrade" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentMark" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentAge" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Song, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Chart, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock x:Name="Score" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Score}"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="Grade" Grid.Column="2" MinWidth="40" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Grade}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="Mark" Grid.Column="3" MinWidth="96" MaxWidth="150" Margin="10,0,0,0" TextAlignment="Right"
                                                   VerticalAlignment="Center" Text="{Binding Mark}" Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" MinWidth="44" Margin="10,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding Age}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGold}" Value="True">
                                        <Setter TargetName="Grade" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Recorded}" Value="False">
                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <!-- a bulk capture run is one line with its count, and no score of its own -->
                                    <DataTrigger Binding="{Binding IsRun}" Value="True">
                                        <Setter TargetName="Score" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Grade" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="ReviewRow" Style="{StaticResource WarnRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                                <Hyperlink Click="OnReview"><Run Text="{x:Static app:Copy.Review}" /></Hyperlink>
                            </TextBlock>
                            <Path DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="M8,1.5 L15,14 L1,14 Z" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="ReviewText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static app:Copy.SectionNotifications}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="NotificationsBox" Style="{StaticResource Switch}" Content="{x:Static app:Copy.ShowNotifications}"
                              Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                    <StackPanel x:Name="NotificationKinds" Margin="52,8,0,0">
                        <CheckBox x:Name="NotifyRecordedBox" Margin="0,2" Content="{x:Static app:Copy.NotifyRecorded}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                        <CheckBox x:Name="NotifyNotRecordedBox" Margin="0,2" Content="{x:Static app:Copy.NotifyNotRecorded}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                        <CheckBox x:Name="NotifyUnreadableBox" Margin="0,2" Content="{x:Static app:Copy.NotifyUnreadable}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                        <CheckBox x:Name="NotifyTokenRejectedBox" Margin="0,2" Content="{x:Static app:Copy.NotifyTokenRejected}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                        <CheckBox x:Name="NotifyUpdatedBox" Margin="0,2" Content="{x:Static app:Copy.NotifyUpdated}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                        <CheckBox x:Name="NotifyBulkFinishedBox" Margin="0,2" Content="{x:Static app:Copy.NotifyBulkFinished}"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LanguageLabel" Text="{x:Static app:Copy.SectionLanguage}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="240" DisplayMemberPath="Name"
                          AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" SelectionChanged="OnLanguageChanged" />
            </Border>

            <DockPanel Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="12,4" Margin="0,0,8,0" Content="{x:Static app:Copy.OpenLogs}" Click="OnOpenLogs" />
                    <Button Padding="14,4" Content="{x:Static app:Copy.Quit}" Click="OnQuit" />
                </StackPanel>
                <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
