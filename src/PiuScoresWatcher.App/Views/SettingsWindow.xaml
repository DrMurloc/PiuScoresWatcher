<Window x:Class="PiuScoresWatcher.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIU Scores Watcher"
        Width="460" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Placeholder copy throughout: the owner writes every player-facing line. The window exists
         so the tray has somewhere to open; the token, the mode and Start with Windows land here
         with their commits. -->
    <StackPanel Margin="24" >
        <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="SiteText" Margin="0,4,0,16" Opacity="0.7" />

        <TextBlock Text="Watching" FontWeight="SemiBold" />
        <TextBlock x:Name="ModeText" Margin="0,2,0,12" />

        <TextBlock Text="Data folder" FontWeight="SemiBold" />
        <TextBlock x:Name="DataFolderText" Margin="0,2,0,12" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal">
            <Button Content="Open logs folder" Click="OnOpenLogs" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
