<Application x:Class="PiuScoresWatcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <!-- The tray icon is the app; windows come and go. Closing a window must not exit, hence
         OnExplicitShutdown: only Quit does. The tray icon and its menu are built in App.xaml.cs,
         because their status line changes as the watcher works. -->
</Application>
